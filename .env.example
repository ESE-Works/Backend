# Supabase PostgreSQL 연결 정보
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Swagger 서버 목록 (개발 서버 접속 주소, try it out 용)
SWAGGER_SERVER_URL=http://136.66.69.44:4000
SWAGGER_SERVER_URL_NGROK=https://b667-136-66-69-44.ngrok-free.app

# OpenAI (계약서 분석)
OPENAI_API_KEY=your-openai-api-key-here

# 국토교통부 실거래가 API (data.go.kr, 무료 발급)
DATA_GO_KR_API_KEY=your-data-go-kr-api-key-here

# Firebase Cloud Messaging (알림 발송)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
